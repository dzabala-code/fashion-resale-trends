# eBay Browse API (https://developer.ebay.com)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fashion-resale-trends/1.0

GOOGLE_TRENDS_GEO=FR
# Use bundled fixture data when a source is unreachable
USE_FIXTURES_IF_SOURCE_FAIL=false

# Storage: "local" (./data_lake) or "s3" (MinIO)
STORAGE_BACKEND=local
MINIO_BUCKET=fashion-trends
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

ELASTICSEARCH_URL=http://elasticsearch:9200
KEYWORD_INDEX=fashion_keyword_scores
OFFER_INDEX=fashion_offer_recommendations
